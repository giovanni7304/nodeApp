    {
      "parameters": {
        "jsCode": "// Grab the base64 string from the \"voice\" key\nlet base64Data = $input.item.json.body.voice;\n\nif (!base64Data) {\n  throw new Error('No audio base64 data found in request. Check your Webhook output again.');\n}\n\n// Just in case iOS appended a mime-type prefix like \"data:audio/m4a;base64,\" \nif (base64Data.includes(',')) {\n  base64Data = base64Data.split(',')[1];\n}\n\n// Convert the base64 string into a true memory Buffer\nconst buffer = Buffer.from(base64Data, 'base64');\n\n// Use n8n's official internal helper to construct the file attachment\nconst binaryData = await this.helpers.prepareBinaryData(buffer, 'memo.m4a', 'audio/m4a');\n\nreturn {\n  json: $input.item.json,\n  binary: {\n    data: binaryData\n  }\n};\n\n"
      },
      "id": "5b93a950-9972-4105-9104-257bb0f78ec6",
      "name": "Base64 to Binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ]
    },
    {
      "parameters": {
        "prompt": "=You are a personal assistant that organizes voice memos. Read the provided transcription and extract the following details into JSON format exactly:\n{\n  \"Type\": \"Journal\",\n  \"Date\": \"YYYY-MM-DD\",\n  \"Created Time\": \"HH:mm\",\n  \"Focus area\": \"Personal\",\n  \"Mood\": \"Neutral\",\n  \"Significance\": \"Medium\",\n  \"Source\": \"Voice Memo\",\n  \"Summary\": \"A short paragraph summarizing the memo\"\n\"Title\": \"Title Depicting the voice memo\"\n\"Full Message\": \"Entire text message\"\n}\n\nHere is the transcription:\n={{ $json.text }}\n",
        "options": {
          "maxTokens": 1000
        },
        "requestOptions": {}
      },
      "id": "1b9fabad-b32d-4660-a66a-2ae90c526999",
      "name": "Extract JSON",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        608,
        0
      ],
      "credentials": {
        "openAiApi": {
          "id": "FFOh5hfhcOxMpSFR",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 1. Grab the \"text\" string from the Whisper/ChatGPT output\nlet content = $input.item.json.text; \n\n// (Fallback for other node versions)\nif (!content && $input.item.json.message && $input.item.json.message.content) {\n   content = $input.item.json.message.content;\n}\n\n// 2. Clean out any Markdown or extra junk\nif (content.startsWith(\"```json\")) {\n   content = content.replace(/^```json\\n/, \"\"); // Remove start\n   content = content.replace(/```$/, \"\");       // Remove end\n}\ncontent = content.trim();\n\n// 3. Format it for Notion by parsing the string into a real object\nconst structuredData = JSON.parse(content);\n\n// 4. Output the structured fields\nreturn { json: structuredData };\n"
      },
